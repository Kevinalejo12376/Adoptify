# Copia este archivo como .env
# URL base del backend FastAPI.
VITE_API_URL=http://127.0.0.1:8000

# NOTA SOBRE IMÁGENES:
# Todas las imágenes (perfil, refugios, mascotas, productos, foro, etc.)
# se suben automáticamente a Cloudinary a través del backend
# (endpoint unificado POST /api/upload). El frontend NUNCA guarda archivos
# locales ni base64 en la base de datos: solo usa la `secure_url` devuelta.
# Por eso NO se necesitan credenciales de Cloudinary en el frontend.
