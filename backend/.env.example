# Copia este archivo como .env y ajusta los valores.

# Cadena de conexion a la base de datos.
# SQLite (desarrollo local):
DATABASE_URL="sqlite:///./adoptify.db"
# PostgreSQL / Supabase (produccion):
# DATABASE_URL="postgresql://usuario:contrasena@host:5432/nombre_bd"

# Clave secreta para firmar los JWT. Genera una con:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY="cambia_esto_por_una_clave_segura"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES="30"

# Origenes permitidos para CORS (URLs del frontend).
# En desarrollo local:
CORS_ORIGINS='["http://localhost:3000", "http://localhost:5173"]'
# En produccion (Vercel), descomenta y ajusta:
# CORS_ORIGINS='["https://adoptify-frontend.vercel.app", "http://localhost:5173"]'
# O usa ["*"] para permitir todos los origenes (no recomendado en produccion):
# CORS_ORIGINS=["*"]

# --- Brevo (Sendinblue) — envío de correos ---
# Obtén tu API Key v3 en: https://app.brevo.com/settings/keys/smtp
# El remitente (BREVO_FROM_EMAIL) debe estar verificado en Brevo:
# https://app.brevo.com/senders
# En el plan gratuito puedes verificar un remitente único sin dominio.
BREVO_API_KEY="xkeysib-tu_api_key"
BREVO_FROM_EMAIL="tu_correo@gmail.com"
BREVO_FROM_NAME="Adoptify"

# --- URL del frontend (para enlaces en correos) ---
# En desarrollo local:
FRONTEND_URL="http://localhost:5173"
# En produccion (Vercel), descomenta y ajusta:
# FRONTEND_URL="https://adoptify-frontend.vercel.app"

# --- Google OAuth ---
# Client ID de Google Cloud Console (Web application)
# Crear credenciales en: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=""

# --- Cloudinary (gestión unificada de TODAS las imágenes del sistema) ---
# Perfiles de usuario, logos/portadas de refugios y tiendas, mascotas,
# productos del Marketplace, publicaciones del foro, banners y también las
# imágenes TEMPORALES de IA/escaneos/previews (carpeta temp/).
# En la base de datos solo se almacena la secure_url (nunca el archivo).
# Obtén estas credenciales desde Cloudinary Dashboard > Dashboard
CLOUDINARY_CLOUD_NAME="tu-cloud-name"
CLOUDINARY_API_KEY="123456789012345"
CLOUDINARY_API_SECRET="tu-api-secret"

# --- UPCitemDB (búsqueda por código de barras) ---
# Opcional. Si no se configura, solo se usará OpenFoodFacts (gratuito).
# Obtén una API Key gratuita registrándote en: https://upcitemdb.com/
# IMPORTANTE: la API de UPCitemDB usa el header "x-api-key" (NO Bearer).
# - Sin API Key: se usa el endpoint trial (~100 consultas/día por IP,
#   a veces devuelve resultados imprecisos para códigos no existentes).
# - Con API Key: se usa el endpoint de producción /prod/lookup (más preciso).
#   Plan "Developer": $49/mes (~100k consultas/día).
UPCITEMDB_API_KEY=""

# --- Google Gemini API (análisis de productos con IA) ---
# Obtén una API Key gratuita en: https://aistudio.google.com/apikey
# Esta clave es necesaria para la funcionalidad "Analizar producto con IA"
# que permite extraer datos estructurados de las fotos del producto.
GEMINI_API_KEY=""

# ============================================================
# n8n (automatizaciones / IA asíncrona / notificaciones)
# ============================================================
# Activa la integracion con n8n. Si es true, el backend intenta usar n8n
# (webhooks) y, si n8n NO responde o falla, usa el respaldo interno:
#   - Correos -> Brevo directo
#   - Chatbot -> Gemini interno
# Si es false, no se disparan webhooks y todo usa el respaldo interno.
N8N_ENABLED=true
# URL base de n8n (sin /webhook).
#   Local:  http://localhost:5678
#   n8n Cloud: https://TU-INSTANCIA.app.n8n.cloud  (la URL que te da n8n Cloud)
N8N_WEBHOOK_URL="http://localhost:5678"
# Token secreto compartido backend <-> n8n. DEBE ser el MISMO valor que
# configures en n8n Cloud (Settings -> Environment Variables, N8N_WEBHOOK_SECRET).
# Genera uno con:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
N8N_WEBHOOK_SECRET="cambia_este_token_secreto"
# Timeout (seg) que el backend espera la respuesta de un webhook de n8n.
# En n8n Cloud puede ser mayor (la respuesta tarda más que en local).
N8N_WEBHOOK_TIMEOUT=45
# URL pública del backend (para que n8n llame a la API).
#   Local + n8n local:   http://localhost:8000
#   n8n Cloud + backend local: usa un túnel (ngrok/cloudflared) o la URL del backend desplegado
#   n8n Cloud + backend Vercel: https://TU-BACKEND.vercel.app
BACKEND_PUBLIC_URL="http://127.0.0.1:8000"

# ============================================================
# WhatsApp (notificaciones externas, opt-in del usuario)
# Estas variables las usa n8n (workflows WF-6 Chatbot y WF-7 Notificaciones)
# para enviar/recibir por WhatsApp. El backend enruta via n8n (enviar_whatsapp).
# ============================================================
# Proveedor: twilio (pruebas, sandbox gratis) | meta (produccion)
WHATSAPP_PROVIDER="twilio"

# Twilio WhatsApp (pruebas - Sandbox gratis, sin aprobación de negocio)
# https://console.twilio.com > Messaging > Try it out > Send a WhatsApp message
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_WHATSAPP_FROM="whatsapp:+14155238886"

# Meta Cloud API (producción) - requiere número de negocio aprobado
# https://developers.facebook.com/docs/whatsapp/cloud-api
META_WHATSAPP_TOKEN=""
META_WHATSAPP_PHONE_ID=""
META_WHATSAPP_VERSION="v20.0"

# ============================================================
# Chatbot (IA)
# ============================================================
# Ventana de historial (mensajes) que se envían al workflow de n8n como contexto
CHAT_MAX_HISTORIAL=10
# Rutas que el chatbot puede sugerir navegar (lista blanca, separadas por comas)
CHAT_RUTAS_PERMITIDAS='["/", "/animals", "/shelters", "/store", "/forum", "/mis-pedidos", "/favoritos", "/login", "/register", "/registrar-refugio", "/registrar-tienda"]'

