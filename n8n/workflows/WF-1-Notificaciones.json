{
  "name": "WF-1 Notificaciones",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "enviar_correo",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "5f3f8a1e-0000-4000-8000-000000000001",
      "name": "Webhook enviar_correo",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 0],
      "webhookId": "5f3f8a1e-0000-4000-8000-000000000001"
    },
    {
      "parameters": {
        "jsCode": "// Prepara el cuerpo del correo para la API de Brevo.\n// El webhook de n8n puede entregar el cuerpo como $json (directo) o como $json.body.\nconst raw = $input.first().json || {};\nconst bodyObj = (raw.body && typeof raw.body === 'object') ? raw.body : raw;\nconst p = (bodyObj.payload && typeof bodyObj.payload === 'object') ? bodyObj.payload : bodyObj;\nreturn [{\n  json: {\n    sender: { name: $env.BREVO_FROM_NAME, email: $env.BREVO_FROM_EMAIL },\n    to: [{ email: p.to }],\n    subject: p.asunto,\n    htmlContent: (p.html || '')\n  }\n}];"
      },
      "id": "5f3f8a1e-0000-4000-8000-000000000010",
      "name": "Preparar correo",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [220, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.brevo.com/v3/smtp/email",
        "sendHeaders": true,
        "specifyHeaders": "keypair",
        "headerParameters": {
          "parameters": [
            {
              "name": "api-key",
              "value": "={{ $env.BREVO_API_KEY }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "Accept",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ $json }}",
        "options": {
          "timeout": 30000
        }
      },
      "id": "5f3f8a1e-0000-4000-8000-000000000002",
      "name": "Enviar correo Brevo",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [440, 0]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { ok: true } }}",
        "options": {}
      },
      "id": "5f3f8a1e-0000-4000-8000-000000000011",
      "name": "Responder al webhook",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [660, 0]
    }
  ],
