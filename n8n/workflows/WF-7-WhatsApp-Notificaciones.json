    {
      "parameters": {
        "jsCode": "// Prepara la llamada al proveedor de WhatsApp (Twilio o Meta) segun $env.WHATSAPP_PROVIDER.\nconst body = $input.first().json; // {telefono, mensaje}\nconst prov = ($env.WHATSAPP_PROVIDER || 'twilio').toLowerCase();\nconst telefono = String(body.telefono || '').replace(/^\\+/, ''); // E.164 sin '+'\nconst mensaje = String(body.mensaje || '');\nlet url = '';\nlet headers = {};\nlet meta = null;\nlet twilio = null;\nif (prov === 'meta') {\n  url = 'https://graph.facebook.com/' + ($env.META_WHATSAPP_VERSION || 'v20.0') + '/' + $env.META_WHATSAPP_PHONE_ID + '/messages';\n  headers = { Authorization: 'Bearer ' + $env.META_WHATSAPP_TOKEN };\n  meta = { messaging_product: 'whatsapp', to: telefono, type: 'text', text: { body: mensaje } };\n} else {\n  url = 'https://api.twilio.com/2010-04-01/Accounts/' + $env.TWILIO_ACCOUNT_SID + '/Messages.json';\n  headers = { Authorization: 'Basic ' + Buffer.from($env.TWILIO_ACCOUNT_SID + ':' + $env.TWILIO_AUTH_TOKEN).toString('base64') };\n  twilio = { From: $env.TWILIO_WHATSAPP_FROM, To: 'whatsapp:' + telefono, Body: mensaje };\n}\nreturn [{ json: { provider: prov, url, headers, meta, twilio } }];"
      },
      "id": "5f3f8a1e-0000-4000-8000-000000000071",
      "name": "Preparar envío",
