# ========================================
# Configuración de autenticación
# ========================================

N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=cambiar_esta_contraseña

# ========================================
# Zona horaria
# ========================================

GENERIC_TIMEZONE=America/Bogota
TZ=America/Bogota

# ========================================
# Variables usadas por los workflows (via $env)
# ========================================

# Token secreto compartido backend <-> n8n.
# DEBE ser el mismo valor que N8N_WEBHOOK_SECRET en backend/.env
N8N_WEBHOOK_SECRET=cambia_este_token_secreto

# URL pública del backend FastAPI.
# Local: http://127.0.0.1:8000
# Produccion: https://TU-BACKEND.com
BACKEND_PUBLIC_URL=http://127.0.0.1:8000

# API Key de Google Gemini (para WF-2, WF-3 y WF-4, que llaman a Gemini directamente)
# La misma que tienes en backend/.env como GEMINI_API_KEY
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# API Key de Brevo (la misma de backend/.env) para los correos de WF-1 y WF-5.
# Los workflows usan $env.BREVO_API_KEY / $env.BREVO_FROM_EMAIL / $env.BREVO_FROM_NAME
BREVO_API_KEY=tu_api_key_brevo
BREVO_FROM_EMAIL=tu_correo@gmail.com
BREVO_FROM_NAME=Adoptify

# Remitente de los correos enviados desde n8n (WF-1 y WF-5)
SMTP_FROM=tu_correo@gmail.com

# Correo del administrador que recibe los avisos de SLA (WF-5)
ADMIN_EMAIL=admin@adoptify.com

# ========================================
# WhatsApp - Chatbot (WF-6) y Notificaciones (WF-7)
# El backend enruta los mensajes/notificaciones a estos workflows via n8n.
# ========================================

# twilio (pruebas, sandbox gratis) | meta (produccion)
WHATSAPP_PROVIDER=twilio

# Twilio WhatsApp (pruebas - Sandbox gratis)
# https://console.twilio.com > Messaging > Try it out > Send a WhatsApp message
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Meta Cloud API (produccion) - requiere numero de negocio aprobado
# https://developers.facebook.com/docs/whatsapp/cloud-api
META_WHATSAPP_TOKEN=
META_WHATSAPP_PHONE_ID=
META_WHATSAPP_VERSION=v20.0

# ========================================
# Nota sobre SMTP
# ========================================
# Los nodos "Enviar correo SMTP" (WF-1, WF-5) usan una CREDENCIAL de n8n
# (tipo SMTP) creada en: n8n UI > Credentials > New > SMTP.
# Allí configuras host, puerto, usuario y contraseña de aplicación.
